rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One claim per wishlist item, no names. Anyone can see which items are taken.
    // Creating only works if nobody has claimed it yet,
    // and only the device that claimed it can unclaim.
    match /claims/{itemId} {
      allow read: if true;
      allow create: if request.auth != null
        && itemId.size() <= 60
        && request.resource.data.keys().hasOnly(['uid', 'at'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
